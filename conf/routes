# An example controller showing a sample home page
GET     /                           controllers.HomeController.index(request: Request)

GET     /files-signed              controllers.FilesController.s3Signed(key: String)
GET     /create-new-fin-inst       controllers.admin.FinancialInstitutionController.createNewFinInst(request: Request)
POST     /save-new-fin-inst       controllers.admin.FinancialInstitutionController.saveNewFinInst(request: Request)

# Map static resources from the /public folder to the /assets URL path
GET     /assets/*file               controllers.Assets.versioned(path="/public", file: Asset)
